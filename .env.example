# Copie este arquivo para ".env" e troque os dois valores abaixo.
# Este arquivo .env fica SÓ no seu computador/servidor. Nunca o envie a ninguém nem ao GitHub.

# Senha do banco de dados (invente uma).
TMF_POSTGRES_PASSWORD=troque-esta-senha

# Senha das ações de controle no painel (analisar, pausar, kill switch, reiniciar carteira).
TMF_ADMIN_TOKEN=troque-esta-outra-senha

# --- Opcionais (valores padrão entre parênteses) ---
# TMF_PAPER_INITIAL_BALANCE_USD=300        (saldo virtual inicial)
# TMF_AUTONOMY_ENABLED=true                (modo autônomo de simulação ligado ao iniciar)
# TMF_INTERVALS=["5m","1h"]                (temporalidade principal e maior)
# TMF_WATCH_BINANCE_SPOT=["BTCUSDT","ETHUSDT","BNBUSDT","SOLUSDT","XRPUSDT"]
# TMF_RISK_MAX_OPEN_POSITIONS=3
# TMF_RISK_MAX_POSITION_PCT=0.20
# TMF_RISK_MAX_TOTAL_EXPOSURE_PCT=0.50
# TMF_RISK_MAX_DAILY_LOSS_PCT=0.05
# TMF_RISK_MAX_DRAWDOWN_PCT=0.15

# =====================================================================
# MODO REAL (dinheiro de verdade na Binance Spot) — DESLIGADO por padrão
# Leia docs/MODO_REAL.md antes de mexer aqui.
# =====================================================================
# TMF_LIVE_TRADING_ENABLED=true
# TMF_LIVE_CONFIRMATION=ACEITO O RISCO DE PERDER DINHEIRO REAL
# TMF_BINANCE_API_KEY=cole-aqui-a-chave
# TMF_BINANCE_API_SECRET=cole-aqui-o-segredo
# TMF_LIVE_MAX_CAPITAL_USDT=100          (quanto o sistema pode usar; o teto fixo no código é 100)
# Para testar com dinheiro fictício na testnet da Binance:
# TMF_BINANCE_TRADE_REST=https://testnet.binance.vision
