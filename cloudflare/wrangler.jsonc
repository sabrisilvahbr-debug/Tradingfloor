{
  "$schema": "node_modules/wrangler/config-schema.json",
  // O nome precisa ser igual ao nome do Worker no painel da Cloudflare.
  "name": "tradingfloor",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Painel (Next.js exportado como site estático) servido pelo próprio Worker: um só app, um só endereço.
  // O build do painel roda antes de cada deploy; /api, /ws e /health continuam indo para o código do Worker.
  "build": {
    "command": "npm ci --prefix ../frontend --no-audit --no-fund && NEXT_PUBLIC_API_URL= npm run build --prefix ../frontend"
  },
  "assets": {
    "directory": "../frontend/out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/ws/*", "/health"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "FLOOR", "class_name": "Floor" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Floor"] }],
  // A cada 5 minutos o cron garante que o pregão continua rodando, mesmo sem ninguém com a página aberta
  // (o próprio pregão se reagenda a cada 5 segundos; o cron só religa se algo interromper).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "CORS_ORIGIN_REGEX": "^https://(tradingfloor[a-z0-9-]*\\.vercel\\.app|([a-z0-9-]+--)?floor20\\.netlify\\.app|([a-z0-9-]+\\.)?trading-mohamed-floor\\.pages\\.dev)$",
    "BINANCE_REST": "https://data-api.binance.vision",
    // Modelo do Gemini usado na leitura de gráficos por imagem (fase 15). A chave vai no secret GEMINI_API_KEY.
    "GEMINI_MODEL": "gemini-2.5-flash"
  },
  "observability": { "enabled": true }
}
