// Cópia de cloudflare/wrangler.jsonc para o build da Cloudflare que roda na raiz do repositório.
// Ao mudar uma, mude a outra.
{
    // O nome precisa ser igual ao nome do Worker no painel da Cloudflare.
  "name": "trading-mohamed-floor",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "FLOOR", "class_name": "Floor" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Floor"] }],
  // A cada 5 minutos o cron garante que o pregão continua rodando, mesmo sem ninguém com a página aberta
  // (o próprio pregão se reagenda a cada 5 segundos; o cron só religa se algo interromper).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "CORS_ORIGIN_REGEX": "^https://(tradingfloor[a-z0-9-]*\\.vercel\\.app|([a-z0-9-]+--)?floor20\\.netlify\\.app|([a-z0-9-]+\\.)?trading-mohamed-floor\\.pages\\.dev)$",
    "BINANCE_REST": "https://data-api.binance.vision"
  },
  "observability": { "enabled": true }
}
